# Used by the RunPod creation helpers.
# PowerShell uses RUNPOD_API_KEY. Configure runpodctl separately for the shell helper.
RUNPOD_POD_NAME=ai-karate-dev
RUNPOD_IMAGE=YOUR_DOCKERHUB_USERNAME/ai-karate:latest
RUNPOD_GPU_ID=NVIDIA GeForce RTX 4090
RUNPOD_NETWORK_VOLUME_ID=
# Set to true only when intentionally creating disposable /workspace storage.
RUNPOD_ALLOW_EPHEMERAL_VOLUME=false
# Use bytetrack or botsort. The choice is included in the Pod name.
RUNPOD_TRACKER=bytetrack
RUNPOD_TERMINATE_AFTER=8h
RUNPOD_JUPYTER_PASSWORD=GENERATE_A_LONG_RANDOM_VALUE
